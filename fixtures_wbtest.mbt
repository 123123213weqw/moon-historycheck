///|
test "fixture ordered successful history" {
  let result = from_json(
    execute(
      @json.parse(
        "{\"model\":\"register\",\"initial\":0,\"operations\":[{\"id\":\"w\",\"client\":\"cw\",\"call\":1,\"return\":2,\"input\":{\"type\":\"write\",\"value\":1},\"output\":\"ok\"},{\"id\":\"r\",\"client\":\"cr\",\"call\":3,\"return\":4,\"input\":{\"type\":\"read\"},\"output\":1}]}",
      ),
    ),
  )
  assert_eq(
    fixture_at(result, ["verdict"]),
    from_json(@json.parse("\"linearizable\"")),
  )
  assert_eq(
    fixture_at(result, ["witness"]),
    from_json(@json.parse("[\"w\",\"r\"]")),
  )
  assert_eq(fixture_at(result, ["final_state"]), from_json(@json.parse("1")))
}

