      @json.parse(
        "{\"model\":\"lww_map\",\"initial\":{\"k\":{\"value\":2,\"at\":9}},\"operations\":[{\"id\":\"g\",\"client\":\"a\",\"call\":1,\"return\":2,\"input\":{\"type\":\"get\",\"key\":\"k\"},\"output\":1}]}",
