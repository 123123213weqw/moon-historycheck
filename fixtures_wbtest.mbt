// Generated by scripts/fixtures.py from tests/cases.json.

///|
fn fixture_at(value : Value, parts : Array[String]) -> Value {
  let mut current = value
  for part in parts {
    current = match current {
      Object(fields) => fields[part]
      _ => abort("fixture path not object")
    }
  }
  current
}

///|
test "fixture empty register" {
  let result = from_json(
    execute(
      @json.parse("{\"model\":\"register\",\"initial\":0,\"operations\":[]}"),
    ),
  )
  assert_eq(
    fixture_at(result, ["verdict"]),
    from_json(@json.parse("\"linearizable\"")),
  )
  assert_eq(fixture_at(result, ["witness"]), from_json(@json.parse("[]")))
  assert_eq(
    fixture_at(result, ["witness_verified"]),
    from_json(@json.parse("true")),
  )
}

