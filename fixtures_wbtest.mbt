///|
test "fixture reduce to definite pair" {
  let result = from_json(
    execute(
      @json.parse(
        "{\"model\":\"register\",\"initial\":0,\"operations\":[{\"id\":\"noise\",\"client\":\"cnoise\",\"call\":1,\"return\":2,\"input\":{\"type\":\"read\"},\"output\":0},{\"id\":\"w\",\"client\":\"cw\",\"call\":3,\"return\":4,\"input\":{\"type\":\"write\",\"value\":1},\"output\":\"ok\"},{\"id\":\"stale\",\"client\":\"cstale\",\"call\":5,\"return\":6,\"input\":{\"type\":\"read\"},\"output\":0}],\"operation\":\"reduce\"}",
      ),
    ),
  )
  assert_eq(
    fixture_at(result, ["verdict"]),
    from_json(@json.parse("\"non_linearizable\"")),
  )
  assert_eq(
    fixture_at(result, ["remaining_operation_count"]),
    from_json(@json.parse("2")),
  )
  assert_eq(
    fixture_at(result, ["reduction_complete"]),
    from_json(@json.parse("true")),
  )
}

