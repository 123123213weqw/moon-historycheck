  let result = from_json(
    execute(
      @json.parse(
        "{\"model\":\"map\",\"initial\":{\"a\":1},\"operations\":[{\"id\":\"g\",\"client\":\"cg\",\"call\":1,\"return\":2,\"input\":{\"type\":\"get\",\"key\":\"a\"},\"output\":2}]}",
