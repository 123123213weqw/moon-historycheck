    execute(
      @json.parse(
        "{\"model\":\"counter\",\"initial\":0,\"operations\":[{\"id\":\"i\",\"client\":\"ci\",\"call\":1,\"return\":2,\"input\":{\"type\":\"increment\",\"by\":0},\"output\":\"ok\"}]}",
      ),
