      @json.parse(
        "{\"model\":\"lww_map\",\"initial\":{},\"operations\":[{\"id\":\"g\",\"client\":\"a\",\"call\":1,\"return\":2,\"input\":{\"type\":\"get\",\"key\":\"nope\"},\"output\":null}]}",
      ),
    ),
  )
  assert_eq(
    fixture_at(result, ["verdict"]),
    from_json(@json.parse("\"linearizable\"")),
  )
}

